#!/usr/bin/env node
'use strict';

const fs = require('fs');
const path = require('path');
const readline = require('readline');
const { execFileSync, spawnSync } = require('child_process');

const pkg = require('../package.json');

function printHelp() {
  console.log(`optimia v${pkg.version}

Uso:
  optimia                Arranca el servidor web en el directorio actual y abre el navegador.

Opciones:
  -V, --version           Muestra la version.
  -h, --help              Muestra esta ayuda.

La configuracion (modelo de Claude, IA local, instrucciones, memoria, no-go,
skills) se gestiona desde la interfaz web (icono de ajustes), no desde la CLI.
`);
}

function isGitRepo(dir) {
  try {
    execFileSync('git', ['rev-parse', '--git-dir'], { cwd: dir, stdio: 'ignore' });
    return true;
  } catch {
    return false;
  }
}

function ensureGitignoreEntries(dir, entries) {
  const gitignorePath = path.join(dir, '.gitignore');
  let content = fs.existsSync(gitignorePath) ? fs.readFileSync(gitignorePath, 'utf8') : '';
  let changed = false;
  for (const entry of entries) {
    const pattern = new RegExp(`^/?${entry.replace(/^\//, '')}/?$`, 'm');
    if (!pattern.test(content)) {
      if (content.length && !content.endsWith('\n')) content += '\n';
      content += `${entry}\n`;
      changed = true;
    }
  }
  if (changed) fs.writeFileSync(gitignorePath, content);
}

// Mirrors the old bash ensure_project_dir: creates .optimia/, and in git repos
// symlinks .codegraph -> .optimia/.codegraph so the codegraph CLI finds its
// database at the root-level path it expects, without the index landing in git.
function ensureProjectDir(dir) {
  fs.mkdirSync(path.join(dir, '.optimia'), { recursive: true });
  if (!isGitRepo(dir)) return;

  const codegraphLink = path.join(dir, '.codegraph');
  const codegraphReal = path.join(dir, '.optimia', '.codegraph');
  fs.mkdirSync(codegraphReal, { recursive: true });
  if (!fs.existsSync(codegraphLink)) {
    fs.symlinkSync(codegraphReal, codegraphLink);
  }

  ensureGitignoreEntries(dir, ['/.optimia', '/.codegraph']);
}

function askYesNo(question, defaultYes) {
  if (!process.stdin.isTTY) return Promise.resolve(defaultYes);
  const rl = readline.createInterface({ input: process.stdin, output: process.stdout });
  const suffix = defaultYes ? '[S/n]' : '[s/N]';
  return new Promise((resolve) => {
    rl.question(`${question} ${suffix} `, (answer) => {
      rl.close();
      const a = answer.trim().toLowerCase();
      if (!a) return resolve(defaultYes);
      resolve(a === 's' || a === 'si' || a === 'y' || a === 'yes');
    });
  });
}

function codegraphStatePath(dir) {
  return path.join(dir, '.optimia', 'codegraph.json');
}

function loadCodegraphState(dir) {
  const file = codegraphStatePath(dir);
  if (!fs.existsSync(file)) return null;
  try {
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return null;
  }
}

function saveCodegraphState(dir, state) {
  fs.writeFileSync(codegraphStatePath(dir), JSON.stringify(state, null, 2) + '\n');
}

// Trimmed-down version of the old handle_codegraph: ask once whether to enable
// CodeGraph for this repo, then offer to init/sync on each launch. State lives
// in .optimia/codegraph.json instead of the old ~/.config/optimia/repos/*.conf
// registry, since all per-project state now lives under .optimia/.
async function setupCodegraph(dir) {
  if (!isGitRepo(dir)) return;

  let state = loadCodegraphState(dir);
  if (!state) {
    const enabled = await askYesNo('\n¿Activar CodeGraph (indice de codigo para la IA)?', false);
    state = { enabled, initialized: false };
    saveCodegraphState(dir, state);
  }
  if (!state.enabled) return;

  const cgArgs = ['@colbymchenry/codegraph'];
  if (!state.initialized) {
    const doInit = await askYesNo('CodeGraph no esta inicializado. ¿Inicializarlo ahora?', true);
    if (doInit) {
      console.log('Construyendo indice de codigo...');
      spawnSync('npx', [...cgArgs, 'init', '-i'], { cwd: dir, stdio: 'inherit' });
      state.initialized = true;
      saveCodegraphState(dir, state);
      console.log('CodeGraph inicializado.');
    }
  } else {
    const doSync = await askYesNo('¿Sincronizar CodeGraph? (actualizar indice con cambios recientes)', false);
    if (doSync) {
      console.log('Sincronizando indice de codigo...');
      spawnSync('npx', [...cgArgs, 'sync'], { cwd: dir, stdio: 'inherit' });
      console.log('CodeGraph sincronizado.');
    }
  }
}

async function main() {
  const arg = process.argv[2];
  if (arg === '--version' || arg === '-V') {
    console.log(`optimia ${pkg.version}`);
    return;
  }
  if (arg === '--help' || arg === '-h') {
    printHelp();
    return;
  }

  const projectRoot = process.cwd();
  ensureProjectDir(projectRoot);
  await setupCodegraph(projectRoot);

  const { start } = require('../server/index.js');
  await start({ projectRoot });
}

main().catch((err) => {
  console.error(err && err.message ? err.message : err);
  process.exit(1);
});
